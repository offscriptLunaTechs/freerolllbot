# Telegram bot token from @BotFather (secret)
TELEGRAM_BOT_TOKEN=
# Supabase project URL and publishable/anon key
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Shared secret stored in app.config (key = 'api_secret'); gates every RPC
API_SECRET=
# Random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Public URL of this deployment, e.g. https://free-roll.vercel.app
APP_URL=
